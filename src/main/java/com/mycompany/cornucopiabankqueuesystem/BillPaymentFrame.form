          <Properties>
            <Property name="editable" type="boolean" value="false"/>
            <Property name="columns" type="int" value="20"/>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="Segoe UI" size="18" style="1"/>
            </Property>
            <Property name="lineWrap" type="boolean" value="true"/>
            <Property name="rows" type="int" value="5"/>
            <Property name="text" type="java.lang.String" value="1. Select Biller Category &amp; Merchant.&#xa;2. Enter exact Account / Reference No.&#xa;3. Enter Account Holder Name &amp; Amount.&#xa;4. Select Payment Mode (Cash/Check).&#xa;5. Check Priority box if eligible.&#xa;&#xa;Supported Billers Include:&#xa;   &#x2022; Meralco, Maynilad, Manila Water&#xa;   &#x2022; Globe, PLDT, Smart, Converge&#xa;   &#x2022; SSS, Pag-IBIG, PhilHealth, BIR&#xa;   &#x2022; Major Credit Cards &amp; Bank Loans&#xa;&#xa;Please ensure reference details match your physical statement before submitting."/>
            <Property name="wrapStyleWord" type="boolean" value="true"/>
          </Properties>
        </Component>
      </SubComponents>
